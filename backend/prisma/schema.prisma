generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model Area {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  @@map("areas")
}

model Usuario {
  id               Int      @id @default(autoincrement())
  rut              String   @unique
  nombres          String
  apellido_paterno String
  apellido_materno String?
  fecha_nacimiento DateTime
  area_trabajo     String
  password         String
  rol              String   @default("funcionario")

  @@map("usuarios") // Mapea el modelo a la tabla existente 'usuarios'
}

model Documento {
  id        Int      @id @default(autoincrement())
  titulo    String
  url       String   @unique // Nombre del archivo en tu carpeta local (ej: "diat-mutual.pdf")
  categoria String   // Para saber si es de 'accidentes', 'protocolos', 'calidad', etc.
  createdAt DateTime @default(now())

  @@map("documentos") // Nombre de la tabla en PostgreSQL
}